{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "assets/manifest.json",
 "description": "Indeks aset source: status build, hash ROM, source kanonik, encoder. Divalidasi asset_verify.py.",
 "type": "object",
 "required": [
  "assets"
 ],
 "properties": {
  "assets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "symbol",
     "kind",
     "status",
     "rom",
     "source",
     "encoder",
     "semantics"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(?!.*0x[0-9A-Fa-f]{4})[a-z0-9][a-z0-9_/-]*$",
      "description": "Nama stabil semantik, bukan alamat ROM; placeholder `gunk_<alamat>` hanya boleh bila `semantics` = unidentified (lihat ARSITEKTUR-ASET \u00a76)."
     },
     "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "tiles4bpp",
       "tilemap",
       "font_container",
       "glyph_font",
       "glyph_index",
       "palette",
       "sprite",
       "tilemap_bank",
       "compressed_bank",
       "table"
      ]
     },
     "status": {
      "type": "string",
      "enum": [
       "rom-exact",
       "decoded-exact",
       "header-only",
       "opaque"
      ]
     },
     "rom": {
      "type": "object",
      "required": [
       "offset",
       "size",
       "sha256"
      ],
      "properties": {
       "offset": {
        "type": "string",
        "pattern": "^0x[0-9A-Fa-f]+$"
       },
       "size": {
        "type": "integer",
        "minimum": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     },
     "source": {
      "type": "object",
      "required": [
       "json"
      ],
      "properties": {
       "json": {
        "type": "string"
       },
       "png": {
        "type": "string"
       },
       "pal": {
        "type": "string"
       }
      }
     },
     "encoder": {
      "type": "object",
      "required": [
       "tool",
       "version"
      ],
      "properties": {
       "tool": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+\\.py$"
       },
       "version": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "deps": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "codec": {
      "type": [
       "string",
       "null"
      ]
     },
     "evidence": {
      "type": "string"
     },
     "tile_animations": {
      "type": "array",
      "description": "Blok tile beranimasi: header u16 (tiles_per_frame, frames) + body tile dari PNG indeks.",
      "items": {
       "type": "object",
       "required": ["offset", "header", "tiles_per_frame", "frames", "tiles_png", "tiles_wide"],
       "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "header": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": {"type": "integer", "minimum": 0}
        },
        "tiles_per_frame": {"type": "integer", "minimum": 1},
        "frames": {"type": "integer", "minimum": 1},
        "tiles_png": {"type": "string", "minLength": 1},
        "tiles_wide": {"type": "integer", "minimum": 1},
        "note": {"type": "string"}
       }
      }
     },
     "payload_segments": {
      "type": "array",
      "description": "Segmen payload yang dimulai oleh pointer table. Tiap entri punya kind konkret; byte ditulis dari field semantik kind itu (palette: colors, tilemap: entries, frames4bpp: header+tiles, packed: byte terkompresi) dan diverifikasi ulang terhadap ROM.",
      "items": {
       "type": "object",
       "required": ["offset", "size", "kind", "pointer_sources", "evidence"],
       "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 1},
        "kind": {
         "type": "string",
         "enum": ["palette", "tilemap", "frames4bpp", "packed"]
        },
        "pointer_sources": {
         "type": "array",
         "minItems": 1,
         "items": {"type": "string"}
        },
        "evidence": {"type": "string", "minLength": 1},
        "colors": {
         "type": "array",
         "description": "palette: warna BGR555 (bit 15 kosong).",
         "minItems": 1,
         "items": {"type": "integer", "minimum": 0}
        },
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "entries": {
         "type": "array",
         "description": "tilemap: entri u16 urut baris, panjang width*height.",
         "items": {"type": "integer", "minimum": 0}
        },
        "tail": {
         "type": "object",
         "description": "tilemap: ekor sesudah width*height entri, wajib padding alignment 4-byte (byte nol).",
         "required": ["kind", "size"],
         "properties": {
          "kind": {"type": "string", "enum": ["alignment"]},
          "size": {"type": "integer", "minimum": 1}
         }
        },
        "header": {
         "type": "array",
         "items": {"type": "integer", "minimum": 0}
        },
        "tiles_per_frame": {"type": "integer", "minimum": 1},
        "frames": {"type": "integer", "minimum": 1},
        "tiles_png": {
         "type": "string",
         "minLength": 1,
         "description": "frames4bpp: PNG indeks 0..15 (R=G=B=idx*17) berisi tile urut baris; path relatif repo."
        },
        "tiles_wide": {
         "type": "integer",
         "minimum": 1,
         "description": "frames4bpp: jumlah tile per baris PNG."
        },
        "codec": {"type": "string", "enum": ["unpack"]},
        "unpack_size": {"type": "integer", "minimum": 1},
        "unpack_flags": {"type": "integer", "minimum": 0},
        "format": {
         "type": "integer",
         "minimum": 0,
         "maximum": 255,
         "description": "packed: flag stream (lzss bit 0..2, atom 3..4, diff 5..7)."
        },
        "ladder": {
         "type": "array",
         "description": "packed: bit jarak tiap cabang ladder (7 entri lzss 2, 3 entri lzss 3).",
         "minItems": 1,
         "items": {"type": "integer", "minimum": 1, "maximum": 16}
        },
        "huffman": {
         "type": "object",
         "description": "packed: tabel Huffman bila atom != 0; levels[d] = [count, nilai...] urut path.",
         "required": ["bits", "levels"],
         "properties": {
          "bits": {"type": "integer", "enum": [4, 8]},
          "levels": {"type": "array", "items": {"type": "array"}}
         }
        },
        "tokens": {
         "type": "string",
         "minLength": 1,
         "description": "packed: token LZ terpisah ';' (l:<hex> literal, m:<idx>,<dist>,<len> pendek, M:... panjang); popuri.assemble menulis byte terkompresi dari sini."
        },
        "unpacked_sha256": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$",
         "description": "packed: sha256 hasil dekompresi (diverifikasi dengan menjalankan decoder)."
        }
       }
      }
     },
     "padding": {
      "type": "array",
      "description": "Byte non-semantik yang sudah diproven: alignment, container tail, tabel tail, atau region tanpa reader.",
      "items": {
       "type": "object",
       "required": ["offset", "size", "kind", "reason", "evidence"],
       "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "tried": {"type": "array", "items": {"type": "string"}}
       }
      }
     },
     "note": {
      "type": "string"
     },
     "semantics": {
      "type": "string",
      "enum": [
       "proven",
       "unidentified"
      ],
      "description": "proven: id semantik yang sudah terbukti; unidentified: placeholder kanonik gunk_<alamat> karena semantik aset belum terbukti"
     }
    }
   }
  }
 }
}
