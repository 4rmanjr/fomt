{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "assets/manifest.json",
 "description": "Indeks aset source: status build, hash ROM, source kanonik, encoder. Divalidasi asset_verify.py.",
 "type": "object",
 "required": [
  "assets"
 ],
 "properties": {
  "assets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "symbol",
     "kind",
     "status",
     "rom",
     "source",
     "encoder",
     "semantics"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^(?!.*0x[0-9A-Fa-f]{4})[a-z0-9][a-z0-9_/-]*$",
      "description": "Nama stabil semantik, bukan alamat ROM; placeholder `gunk_<alamat>` hanya boleh bila `semantics` = unidentified (lihat ARSITEKTUR-ASET \u00a76)."
     },
     "symbol": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "tiles4bpp",
       "tilemap",
       "font_container",
       "glyph_font",
       "glyph_index",
       "palette",
       "sprite",
       "tilemap_bank",
       "compressed_bank",
       "table"
      ]
     },
     "status": {
      "type": "string",
      "enum": [
       "rom-exact",
       "decoded-exact",
       "header-only",
       "opaque"
      ]
     },
     "rom": {
      "type": "object",
      "required": [
       "offset",
       "size",
       "sha256"
      ],
      "properties": {
       "offset": {
        "type": "string",
        "pattern": "^0x[0-9A-Fa-f]+$"
       },
       "size": {
        "type": "integer",
        "minimum": 1
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     },
     "source": {
      "type": "object",
      "required": [
       "json"
      ],
      "properties": {
       "json": {
        "type": "string"
       },
       "png": {
        "type": "string"
       },
       "pal": {
        "type": "string"
       }
      }
     },
     "encoder": {
      "type": "object",
      "required": [
       "tool",
       "version"
      ],
      "properties": {
       "tool": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+\\.py$"
       },
       "version": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "deps": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "codec": {
      "type": [
       "string",
       "null"
      ]
     },
     "evidence": {
      "type": "string"
     },
     "tile_animations": {
      "type": "array",
      "description": "Blok tile beranimasi: header u16 + byte tile 4bpp.",
      "items": {"type": "object"}
     },
     "padding": {
      "type": "array",
      "description": "Byte non-semantik yang sudah diproven: alignment, container tail, tabel tail, atau region tanpa reader.",
      "items": {
       "type": "object",
       "required": ["offset", "size", "kind", "reason", "evidence"],
       "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "tried": {"type": "array", "items": {"type": "string"}}
       }
      }
     },
     "note": {
      "type": "string"
     },
     "semantics": {
      "type": "string",
      "enum": [
       "proven",
       "unidentified"
      ],
      "description": "proven: id semantik yang sudah terbukti; unidentified: placeholder kanonik gunk_<alamat> karena semantik aset belum terbukti"
     }
    }
   }
  }
 }
}
